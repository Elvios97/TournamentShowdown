# Öffentliche Supabase-Werte für den statischen Deployment-Build.
# Diese Datei wird nicht automatisch geladen. Im Hosting-Anbieter als
# Umgebungsvariablen hinterlegen oder lokal vor `npm run build` setzen.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Optional, falls die App unter einer Subdomain oder einem Unterordner läuft.
BASE_PATH=

# Niemals SUPABASE_SERVICE_ROLE_KEY im Frontend-Deployment hinterlegen.
